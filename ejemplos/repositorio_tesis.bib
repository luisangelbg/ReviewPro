  abstract = {Se evalu{\'o} la inoculaci{\'o}n con hongos micorr{\'i}zicos arbusculares en ma{\'i}z de temporal en ocho parcelas de productores de Chiapas. El rendimiento de grano aument{\'o} 12 % en promedio respecto del testigo sin inocular.},
  keywords = {inoculaci{\'o}n, ma{\'i}z de temporal, micorrizas},
  note = {W25}
}

